{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 50,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/pigma",
    "group/system"
  ],
  "group/pigma": {
    "orientation": "horizontal",
    "modules": [
      "custom/pigma",
      "custom/pigma#like",
      "custom/pigma#prev",
      "custom/pigma#play",
      "custom/pigma#next"
    ],
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": true,
      "children-class": "drawer-child"
    }
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "battery",
      "cpu",
      "memory",
      "temperature"
    ],
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": true,
      "children-class": "drawer-child"
    }
  },
  // 状态模块：连续脚本（无 interval），waybar 逐行读取实时输出。
  // `pigma status --waybar --watch` 订阅 daemon，每次快照变更打印一行 JSON。
  // 若 pigma 未运行会打印 off 并重试；脚本意外退出由 restart-interval 拉起。
  "custom/pigma": {
    "exec": "pigma status --waybar --watch",
    "return-type": "json",
    "exec-on-event": false,
    "restart-interval": 5,
    "tooltip": true,
    "on-click-right": "pigma msg mode",
    "on-scroll-up": "pigma msg volume +5",
    "on-scroll-down": "pigma msg volume -5",
    "format": "{}"
  },
  "custom/pigma#like": {
    "exec": "pigma status --waybar --icon like --watch",
    "return-type": "json",
    "exec-on-event": false,
    "restart-interval": 5,
    "on-click": "pigma msg toggle_like",
    "on-scroll-up": "pigma msg volume +5",
    "on-scroll-down": "pigma msg volume -5",
    "format": "{}"
  },
  "custom/pigma#prev": {
    "exec": "pigma status --waybar --icon prev",
    "interval": "once",
    "return-type": "json",
    "on-click": "pigma msg previous",
    "on-scroll-up": "pigma msg volume +5",
    "on-scroll-down": "pigma msg volume -5",
    "format": "{}"
  },
  "custom/pigma#play": {
    "exec": "pigma status --waybar --icon play --watch",
    "return-type": "json",
    "exec-on-event": false,
    "restart-interval": 5,
    "on-click": "pigma msg toggle_play",
    "on-scroll-up": "pigma msg volume +5",
    "on-scroll-down": "pigma msg volume -5",
    "format": "{}"
  },
  "custom/pigma#next": {
    "exec": "pigma status --waybar --icon next",
    "interval": "once",
    "return-type": "json",
    "on-click": "pigma msg next",
    "on-scroll-up": "pigma msg volume +5",
    "on-scroll-down": "pigma msg volume -5",
    "format": "{}"
  }
}